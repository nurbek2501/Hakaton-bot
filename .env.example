# @BotFather bergan token
BOT_TOKEN=1234567890:AAAA-bbbbCCCCddddEEEE

# Webhook manzilining maxfiy qismi (uzun tasodifiy satr, faqat harf/raqam/-)
WEBHOOK_SECRET_PATH=uzun-tasodifiy-satr-7f3k9x2m

# Telegram har so‘rovda yuboradigan maxfiy kalit (faqat A-Z a-z 0-9 _ -)
WEBHOOK_SECRET_TOKEN=boshqa_tasodifiy_satr_Q8w2Lp

# PythonAnywhere manzilingiz (USERNAME o‘rniga o‘z loginingiz)
WEBHOOK_HOST=https://USERNAME.pythonanywhere.com

# PythonAnywhere bepul tarifida 1, lokal kompyuterda 0
USE_PROXY=1

# Adminlar Telegram ID’lari (vergul bilan). /stats va /export shular uchun
ADMIN_IDS=123456789

# 1 - har bir anketa nusxasi bot.db da ham saqlanadi va admin /export buyrug‘i bilan
#     hammasini bitta Excel faylda oladi (tavsiya etiladi).
# 0 - Formaga yuborilgach shaxsiy ma’lumotlar botdan o‘chiriladi (/export faqat
#     yuborilmay qolganlarni beradi). bot.db faylini hech kimga bermang!
KEEP_LOCAL_COPY=1

# Loyiha fayllari saqlanadigan YOPIQ kanal ID si (-100 bilan boshlanadi).
# Botni kanalga admin qilib qo‘shsangiz, bot ID ni o‘zi yozib yuboradi.
# Bo‘sh qolsa - fayllar ADMIN_IDS dagi adminlarga yuboriladi
STORAGE_CHAT_ID=

# (ixtiyoriy) «Yangi Xatirchi» kanal havolasi - muvaffaqiyat xabarida tugma bo‘lib chiqadi
CHANNEL_URL=
